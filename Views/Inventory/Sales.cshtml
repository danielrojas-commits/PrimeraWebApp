@{
    ViewData["Title"] = "Ventas";
}

<div class="container mt-4">
    <h2>Listado de Ventas</h2>

    @{
        var ventas = ViewBag.Sales as List<Dictionary<string, object>>;
        var columns = ViewBag.Columns as List<string> ?? new List<string>();
    }

    @if (ventas != null && ventas.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-registros">
                <thead class="table-registros-header">
                    <tr>
                        @foreach (var col in columns)
                        {
                            <th>@col</th>
                        }
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in ventas)
                    {
                        <tr>
                            @foreach (var col in columns)
                            {
                                <td>@(v.ContainsKey(col) && v[col] != null ? v[col].ToString() : "")</td>
                            }
                            <td>
                                <a asp-controller="Inventory" asp-action="SaleReceipt" asp-route-id="@(v[columns[0]])" class="btn btn-sm btn-primary">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No hay ventas registradas.</div>
    }
</div>