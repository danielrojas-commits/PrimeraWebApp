@{
    ViewData["Title"] = "Registrar venta";
}

<div class="container mt-4">
    <h2>Registrar venta</h2>

    <!-- Botones de acción removidos para flujo de ventas profesional -->

    @{
        var products = ViewBag.Products as List<Dictionary<string, object>>;
        var columns = ViewBag.Columns as List<string> ?? new List<string>();
        var keyColumn = ViewBag.KeyColumn as string ?? "id";
    }

    @if (products != null && products.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-registros">
                <thead class="table-registros-header">
                    <tr>
                        @foreach (var col in columns)
                        {
                            <th>@col</th>
                        }
                        <th>Venta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in products)
                    {
                        <tr>
                            @foreach (var col in columns)
                            {
                                <td>@(row.ContainsKey(col) && row[col] != null ? row[col].ToString() : "")</td>
                            }
                            <td>
                                <form asp-controller="Inventory" asp-action="RegisterSale" method="post" class="d-flex">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="keyColumn" value="@keyColumn" />
                                    <input type="hidden" name="idValue" value="@row[keyColumn]" />
                                    <input type="number" name="cantidad" min="1" value="1" class="form-control" style="width:120px;" />
                                    <button type="submit" class="btn btn-primary ms-2">Vender</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No hay productos para vender.</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Success"]</div>
    }

</div>
