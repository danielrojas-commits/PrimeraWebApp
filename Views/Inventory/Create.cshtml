@{
    ViewData["Title"] = "Añadir Producto";
}

<div class="container mt-4">
    <h2>Añadir producto</h2>

    @using (Html.BeginForm("Create", "Inventory", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" name="nombre" id="nombre" class="form-control" value="" />
            @Html.ValidationMessage("nombre", "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="precio" class="form-label">Precio</label>
            <input type="number" step="0.01" name="precio" id="precio" class="form-control" value="0" />
            @Html.ValidationMessage("precio", "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="stock" class="form-label">Stock</label>
            <input type="number" name="stock" id="stock" class="form-control" value="0" />
            @Html.ValidationMessage("stock", "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="categoriaId" class="form-label">Categoría</label>
            @{
                var categorias = ViewBag.Categories as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();
                var catKey = ViewBag.CatKeyColumn as string ?? "id";
                var catLabel = ViewBag.CatLabelColumn as string ?? "nombre";
            }
            <div class="d-flex">
                <select name="categoriaId" id="categoriaId" class="form-select me-2">
                    <option value="">-- Seleccione --</option>
                    @foreach (var c in categorias)
                    {
                        <option value="@c[catKey]">@((c.ContainsKey(catLabel) && c[catLabel] != null) ? c[catLabel].ToString() : c[catKey].ToString())</option>
                    }
                </select>
                <a asp-controller="Inventory" asp-action="CreateCategory" class="btn btn-outline-secondary">Crear categoría</a>
            </div>
            @Html.ValidationMessage("categoriaId", "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">Añadir</button>
        <a asp-controller="Inventory" asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
    }
</div>
