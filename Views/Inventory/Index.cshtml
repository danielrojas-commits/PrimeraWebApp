@{
    ViewData["Title"] = "Inventario";
}

<div class="container mt-4">
    <h2>Inventario</h2>

    <div class="mb-3">
        <a asp-controller="Inventory" asp-action="Create" class="btn btn-success">Añadir producto</a>
        <a asp-controller="Inventory" asp-action="Historial" class="btn btn-secondary ms-2">Historial</a>
    </div>

    @{
        var products = ViewBag.Products as List<Dictionary<string, object>>;
        var columns = ViewBag.Columns as List<string> ?? new List<string>();
        var keyColumn = ViewBag.KeyColumn as string ?? "id";
    }

    @if (products != null && products.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        @foreach (var col in columns)
                        {
                            <th>@col</th>
                        }
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in products)
                    {
                        <tr>
                            @foreach (var col in columns)
                            {
                                if (string.Equals(col, keyColumn, System.StringComparison.OrdinalIgnoreCase))
                                {
                                    <td>@row[col]</td>
                                }
                                else if (string.Equals(col, "stock", System.StringComparison.OrdinalIgnoreCase))
                                {
                                    // input form to update stock. If stock == 0 show 'Sin stock'
                                    var stockText = row.ContainsKey("stock") && row["stock"] != null ? row["stock"].ToString() : "0";
                                    int stockVal;
                                    int.TryParse(stockText, out stockVal);

                                    <td class="text-end align-middle">
                                        @if (stockVal == 0)
                                        {
                                            <span class="badge bg-danger me-2">Sin stock</span>
                                        }

                                        <form asp-controller="Inventory" asp-action="Update" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="keyColumn" value="@keyColumn" />
                                            <input type="hidden" name="idValue" value="@row[keyColumn]" />
                                            <input type="number" name="stock" value="@stockVal" min="0" class="form-control d-inline-block" style="width:100px;" />
                                            <button type="submit" class="btn btn-sm btn-primary ms-2">Actualizar</button>
                                        </form>
                                    </td>
                                }
                                else
                                {
                                    <td>@(row[col]?.ToString() ?? "")</td>
                                }
                            }

                            <td class="text-center align-middle">
                                <form asp-controller="Inventory" asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar este producto? Esta acción no se puede deshacer.');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="keyColumn" value="@keyColumn" />
                                    <input type="hidden" name="idValue" value="@row[keyColumn]" />
                                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No hay productos para mostrar.</div>
    }

</div>
