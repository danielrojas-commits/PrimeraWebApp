@{
    ViewData["Title"] = "Historial";
}

<div class="container mt-4">
    <h2>Historial de registros</h2>

    @{
        var records = ViewBag.Records as List<Dictionary<string, object>>;
        var columns = ViewBag.Columns as List<string> ?? new List<string>();
    }

    @if (records != null && records.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        @foreach (var col in columns)
                        {
                            <th>@col</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in records)
                    {
                        <tr>
                            @foreach (var col in columns)
                            {
                                <td>@(row.ContainsKey(col) && row[col] != null ? row[col].ToString() : "")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No hay registros en la tabla 'registros' o no se pudo leer la tabla.</div>
    }

</div>
