<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASOAGRO</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PrimeraWebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="me-2">ASOAGRO</span>
                    <small class="text-light opacity-75">Ventas · Inventario · Gestión</small>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inventory" asp-action="Index">Inventario</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ventas" asp-action="Index">Ganancias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inventory" asp-action="RegisterSale">Registrar venta</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inventory" asp-action="Sales">Ventas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Index">Usuarios</a>
                        </li>
                    </ul>
                    <form class="d-flex me-3" role="search" method="get" asp-controller="Inventory" asp-action="Index">
                        <input class="form-control form-control-sm me-2" type="search" placeholder="Buscar producto" aria-label="Buscar" name="q">
                        <button class="btn btn-outline-light btn-sm" type="submit">Buscar</button>
                    </form>
                    <div class="dropdown">
                        <a class="btn btn-light btn-sm dropdown-toggle" href="#" role="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                            @{
                                var userName = "Admin";
                                try
                                {
                                    if (Context.Request.Cookies.ContainsKey("user_name") && !string.IsNullOrEmpty(Context.Request.Cookies["user_name"])) userName = Context.Request.Cookies["user_name"];
                                    else if (Context.Request.Cookies.ContainsKey("user_email") && !string.IsNullOrEmpty(Context.Request.Cookies["user_email"])) userName = Context.Request.Cookies["user_email"];
                                }
                                catch { }
                            }
                            @userName
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Usuarios</a></li>
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Create">Nuevo usuario</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Users" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item btn btn-link p-0 m-0 text-start">Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <main class="col-12 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer eliminado para que no aparezca en todo el proyecto -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
