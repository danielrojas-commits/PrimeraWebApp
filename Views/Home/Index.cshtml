@{
    ViewData["Title"] = "Prueba de Conexion";
}
@{
    var products = ViewBag.Products as List<Dictionary<string, object>>;
    var columns = ViewBag.Columns as List<string> ?? new List<string>();
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-3">
    <div class="hero-banner mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-0">Bienvenido a ASOAGRO</h2>
                <p class="text-muted mb-0">Panel de ventas y gestión de inventario — Visualice métricas, gestione productos y registre ventas rápidamente.</p>
            </div>
            <div class="text-end">
                <div class="mb-2">
                    <a class="btn btn-sm btn-success me-2" asp-controller="Inventory" asp-action="Create">Añadir producto</a>
                    <a class="btn btn-sm btn-outline-success" asp-controller="Inventory" asp-action="RegisterSale">Registrar venta</a>
                </div>
                @if (ViewBag.MensajeConexion != null)
                {
                    <div class="alert alert-@ViewBag.EstiloConexion mb-0 small">
                        <strong>Estado: </strong> @ViewBag.MensajeConexion
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card card-metric p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="kpi-number">@((products != null) ? products.Count.ToString() : "0")</div>
                        <div class="kpi-label">Productos totales</div>
                    </div>
                    <div class="text-muted"><i class="bi bi-box-seam"></i></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card card-metric p-3">
                <div>
                    @{ var low = 0; if (products != null) { foreach (var r in products) { if (r.ContainsKey("stock") && int.TryParse(r["stock"]?.ToString() ?? "0", out var s) && s<=5) low++; } } }
                    <div class="kpi-number">@low</div>
                    <div class="kpi-label">Productos con stock bajo (<=5)</div>
                </div>
            </div>
        </div>

        <!-- Se han eliminado las tarjetas 'Ventas hoy' e 'Ingresos (estimado)' según solicitud -->
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Productos recientes</h5>

            @if (products != null && products.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                @foreach (var col in columns)
                                {
                                    <th>@col</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in products)
                            {
                                <tr>
                                    @foreach (var col in columns)
                                    {
                                        var cellValue = row.ContainsKey(col) && row[col] != null ? row[col] : null;
                                        if (cellValue == null)
                                        {
                                            <td></td>
                                        }
                                        else if (string.Equals(col, "stock", System.StringComparison.OrdinalIgnoreCase))
                                        {
                                            int stockVal;
                                            var stockText = cellValue.ToString();
                                            if (int.TryParse(stockText, out stockVal))
                                            {
                                                var badgeClass = stockVal <= 5 ? "badge-stock-low" : "badge-stock-ok";
                                                <td class="text-end"><span class="badge @badgeClass">@stockVal</span></td>
                                            }
                                            else
                                            {
                                                <td class="text-end">@stockText</td>
                                            }
                                        }
                                        else
                                        {
                                            <td>@cellValue.ToString()</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">No hay registros en la tabla 'productos' o no se pudo leer la tabla.</div>
            }
        </div>
    </div>

</div>
